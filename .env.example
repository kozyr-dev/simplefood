# The Nest API (api/, port 1339 locally). See next.config.ts.
# `next dev`: server-side calls, and the browser unless NEXT_PUBLIC_API_URL is set.
DEV_API_URL=http://localhost:1339
# `next build` (production): server-side calls; may be an internal address.
PROD_API_URL=https://api-simplefood.kozyr.info
# The browser and image URLs: always the public address.
NEXT_PUBLIC_API_URL=http://localhost:1339
